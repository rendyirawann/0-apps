APP_NAME="Transaksi Pekerjaan API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# PostgreSQL proyek ini berjalan di 5433, bukan 5432.
DB_PORT=5433
DB_DATABASE=o_taksasi
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Di lokal, database/file sudah cukup dan tidak perlu Redis berjalan.
# Di server, ubah ketiga baris di atas (SESSION_DRIVER, QUEUE_CONNECTION,
# CACHE_STORE) menjadi `redis`.
#
# REDIS_CLIENT: `phpredis` (ekstensi C, lebih cepat) atau `predis` (murni PHP,
# tidak butuh ekstensi). setup-server.sh memasang php8.3-redis, jadi phpredis
# tersedia.
#
# REDIS_CACHE_DB dipisahkan dari REDIS_DB dengan sengaja: cache boleh dibuang
# saat memori penuh, sedangkan antrean tidak boleh -- memisahkannya per
# database membuat `cache:clear` tidak ikut menghapus pekerjaan yang menunggu.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dokumentasi Swagger: http://127.0.0.1:8000/api/documentation
L5_SWAGGER_CONST_HOST=http://127.0.0.1:8000
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true

# Masa hidup access token Sanctum, dalam menit.
SANCTUM_TOKEN_TTL=1440

# ----------------------------------------------------------------- Octane
# Server: frankenphp (biner tunggal, tanpa PECL) | swoole | roadrunner.
# Pasang dulu: php artisan octane:install --server=frankenphp
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
